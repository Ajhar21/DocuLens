# ── Database ─────────────────────────────────────────────────────────
# Connection string for PostgreSQL (psycopg3 driver).
# SQLAlchemy normalizes postgresql:// -> postgresql+psycopg:// automatically.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/doculens

# ── Worker Tunables ──────────────────────────────────────────────────
# WORKER_POLL_INTERVAL_SECONDS=2.0
# WORKER_MAX_ATTEMPTS=3
# WORKER_BACKOFF_BASE_SECONDS=5.0
# WORKER_STUCK_JOB_TIMEOUT_SECONDS=300

